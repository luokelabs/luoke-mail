        "writes": true
      },
      {
        "name": "mail_do",
        "title": "照邮件助手页面上点的按钮处理",
        "writes": true
      },
      {
        "name": "mail_act",
        "title": "处理邮件：归档、删除、移到垃圾邮件、加星标、标已读或未读",
        "writes": true
      },
      {
        "name": "mail_undo_step",
