    "data": [
      "accounts",
      "today",
      "inbox",
      "digest",
      "clean",
      "settings",
      "activity",
      "mail",
      "providers",
      "sender",
      "old",
      "job",
      "piece"
    ],
    "listing": {
      "category": "效率",
      "tagline": "用本机模型整理邮箱，每一步都能撤销"
    },
    "permissions": [
      {
        "facts": [
          "用授权码连接，授权码只存在这台 Mac 的钥匙串里",
          "邮件内容不离开这台 Mac",
          "不发信，不永久删除"
        ],
        "id": "mailbox",
        "kind": "account",
        "page": "accounts",
        "remove": "mail_disconnect",
        "title": "邮箱"
      }
    ],
    "protocol": 1,
    "reports": [
      {
        "kind": "new-mail",
        "title": "要你处理的邮件",
        "urgency": "normal"
      },
      {
        "kind": "suspicious",
        "title": "可疑邮件",
        "urgency": "urgent"
      },
      {
        "kind": "mailbox",
        "title": "邮箱里不急的邮件",
        "urgency": "low"
      },
      {
        "kind": "auto-done",
        "title": "按习惯自动处理的邮件",
        "urgency": "normal"
      },
      {
        "kind": "needs-access",
        "title": "还没连邮箱",
        "urgency": "low"
      }
    ],
    "service": {
      "ask": {
        "search": "mail_search"
      },
      "pages": [
        {
          "id": "today",
          "title": "今日"
        },
        {
          "id": "inbox",
          "title": "收件箱"
        },
        {
          "id": "digest",
          "title": "精选"
        },
        {
          "id": "clean",
          "title": "清理"
        },
        {
          "hidden": true,
          "id": "legacy-settings",
          "title": "邮箱和设置"
        },
        {
          "hidden": true,
          "icon": "history",
          "id": "activity",
          "title": "处理记录"
        },
        {
          "hidden": true,
          "id": "rules",
          "title": "规则"
        },
        {
          "hidden": true,
          "id": "subs",
          "title": "订阅体检"
        },
        {
          "hidden": true,
          "id": "sweep",
          "title": "清理旧邮件"
        },
        {
          "hidden": true,
          "id": "piece",
          "title": "精选内容"
        }
      ],
      "summary": true,
      "ui": {
        "open": "mail_open_page",
        "pages": [
          {
            "id": "accounts",
            "title": "邮箱"
          },
          {
            "id": "rules",
            "title": "规则"
          }
        ]
      }
    },
    "socket": "~/.luoke-mail/run/agent.sock"
  },
  "commands": {
    "uninstall": [
      "-m",
      "luoke_mail",
      "--forget-secrets"
    ]
  },
  "contract": 1,
  "data": [
    "~/.luoke-mail"
  ],
  "data_env": "LUOKE_MAIL_HOME",
  "default_on": true,
  "entry": [
    "-m",
    "luoke_mail",
    "--app"
  ],
  "icon": "AppIcon.icns",
  "jobs": [
    {
      "allow_battery": false,
      "command": [
        "-m",
        "luoke_mail",
        "--job",
        "clean"
      ],
      "memory_mb": 150,
      "min_interval_minutes": 30,
      "name": "clean",
      "timeout_minutes": 30,
      "title": "旧邮件分析",
      "uses_model": true
    },
    {
      "allow_battery": false,
      "command": [
        "-m",
        "luoke_mail",
        "--job",
        "digest"
      ],
      "memory_mb": 150,
      "min_interval_minutes": 30,
      "name": "digest",
      "timeout_minutes": 30,
      "title": "挑选精选内容",
      "uses_model": true
    },
    {
      "allow_battery": false,
      "command": [
        "-m",
        "luoke_mail",
        "--job",
        "learn"
      ],
      "memory_mb": 150,
      "min_interval_minutes": 120,
      "name": "learn",
      "timeout_minutes": 30,
      "title": "从邮件中学习偏好",
      "uses_model": true
    }
  ],
  "memory": true,
  "name": "螺壳邮件助手",
  "resident": false,
  "tasks": [
    {
      "kind": "generate",
      "main": true,
      "name": "luoke-mail.triage"
    },
    {
      "kind": "generate",
      "main": false,
      "name": "luoke-mail.draft"
    },
    {
      "kind": "generate",
      "main": false,
      "name": "luoke-mail.senders"
    },
    {
      "kind": "generate",
      "main": false,
      "name": "luoke-mail.cleanup"
    },
    {
      "kind": "generate",
      "main": false,
      "name": "luoke-mail.digest-read"
    },
    {
      "kind": "generate",
      "main": false,
      "name": "luoke-mail.digest-pick"
    },
    {
      "kind": "generate",
      "main": false,
      "name": "luoke-mail.learn-sent"
    },
    {
      "kind": "generate",
      "main": false,
      "name": "luoke-mail.learn-orgs"
    },
    {
      "kind": "generate",
      "main": false,
      "name": "luoke-mail.thread"
    }
  ],
  "type": "app",
  "ui_element": true,
  "version": "0.19.71"
}
