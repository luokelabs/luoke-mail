        "writes": true
      },
      {
        "name": "mail_digest_source",
        "title": "精选：加入或移出来源",
        "writes": true
      },
      {
        "name": "mail_unsubscribe",
        "title": "一键退订（不能撤销）",
        "writes": true
      },
      {
        "name": "mail_sender_keep",
        "title": "订阅：留着别再问",
